#!/bin/bash
#
# Post-install script for the Snowflake ODBC RS Driver macOS pkg.
# Registers the driver with the iODBC Driver Manager.
#

INSTALL_DIR="/opt/snowflake/snowflakeodbcrs"
DRIVER_PATH="$INSTALL_DIR/lib/libsfodbc.dylib"
ODBC_DIR="$HOME/Library/ODBC"
ODBCINST_FILE="$ODBC_DIR/odbcinst.ini"

mkdir -p "$ODBC_DIR"

DRIVER_ENTRY="[SnowflakeDSIIDriver]
Driver=$DRIVER_PATH
Description=Snowflake DSII"

if [ -f "$ODBCINST_FILE" ]; then
    if grep -q "\[SnowflakeDSIIDriver\]" "$ODBCINST_FILE"; then
        echo "SnowflakeDSIIDriver already registered in $ODBCINST_FILE, updating..."
        sed -i '' '/\[SnowflakeDSIIDriver\]/,/^\[/{/^\[SnowflakeDSIIDriver\]/d;/^Driver=/d;/^Description=/d;/^$/d;}' "$ODBCINST_FILE"
    fi
fi

echo "" >> "$ODBCINST_FILE"
echo "$DRIVER_ENTRY" >> "$ODBCINST_FILE"

echo "Snowflake ODBC RS Driver registered in $ODBCINST_FILE"

if [ -n "$SUDO_UID" ]; then
    chown -R "$SUDO_UID":"$SUDO_GID" "$ODBC_DIR"
fi
