; ODBC Driver Export Definition File
; Only export the ODBC API functions, not internal symbols
; On Windows only W (wide/UTF-16) variants are exported for string-handling functions.
; On Unix both W and non-W (ANSI) variants are available.
LIBRARY sfodbc
EXPORTS
    SQLAllocEnv
    SQLAllocConnect
    SQLAllocHandle
    SQLBindCol
    SQLBindParameter
    SQLColAttributeW
    SQLConnectW
    SQLDescribeColW
    SQLDisconnect
    SQLDriverConnectW
    SQLExecDirectW
    SQLExecute
    SQLExtendedFetch
    SQLFetch
    SQLFetchScroll
    SQLFreeHandle
    SQLFreeStmt
    SQLGetConnectAttrW
    SQLGetData
    SQLGetDescField
    SQLGetDiagFieldW
    SQLGetDiagRecW
    SQLGetEnvAttr
    SQLGetInfoW
    SQLGetStmtAttr
    SQLNumResultCols
    SQLPrepareW
    SQLRowCount
    SQLSetConnectAttrW
    SQLSetDescField
    SQLSetEnvAttr
    SQLSetStmtAttr
