; ODBC Driver Export Definition File
; Only export the ODBC API functions, not internal symbols
LIBRARY sfodbc
EXPORTS
    SQLAllocEnv
    SQLAllocConnect
    SQLAllocHandle
    SQLExecDirect
    SQLExecDirectW
    SQLFreeHandle
    SQLFreeStmt
    SQLConnect
    SQLSetEnvAttr
    SQLGetEnvAttr
    SQLSetConnectAttr
    SQLGetConnectAttr
    SQLGetInfo
    SQLDriverConnect
    SQLDriverConnectW
    SQLDisconnect
    SQLFetch
    SQLFetchScroll
    SQLExtendedFetch
    SQLGetData
    SQLColAttribute
    SQLDescribeCol
    SQLNumResultCols
    SQLRowCount
    SQLBindParameter
    SQLBindCol
    SQLPrepare
    SQLPrepareW
    SQLExecute
    SQLGetDiagRec
    SQLGetDiagField
    SQLSetStmtAttr
    SQLGetStmtAttr
    SQLGetDescField
    SQLSetDescField
