/*
 * Jenkinsfile for code coverage generation and upload to Codecov
 * 
 * Mirrors the GitHub Actions test workflows exactly.
 * Uses Dockerfile.coverage which contains all dependencies.
 * 
 * Setup:
 * 1. Create a new Multibranch Pipeline job in Jenkins
 * 2. Set Script Path to: ci/Jenkinsfile.coverage
 * 3. Add credential 'codecov-token' with the Codecov upload token
 */

pipeline {
    agent {
        label 'build-node-extra-large'
    }
    
    options {
        timestamps()
        disableResume()
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '100'))
        timeout(time: 2, unit: 'HOURS')
    }
    
    triggers {
        cron(env.BRANCH_NAME == 'main' ? 'H 2 * * *' : '')
    }
    
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("universal-driver-coverage:${BUILD_NUMBER}", "-f ci/Dockerfile.coverage ci/")
                }
            }
        }
        
        stage('Setup Secrets') {
            agent {
                docker {
                    image "universal-driver-coverage:${BUILD_NUMBER}"
                    args '-u root --privileged'
                    reuseNode true
                }
            }
            steps {
                sh 'git config --global --add safe.directory $(pwd)'
                withCredentials([
                    string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')
                ]) {
                    sh './scripts/decode_secrets.sh'
                }
            }
        }
        
        stage('Coverage') {
            parallel {
                // =====================================================================
                // Rust Core - mirrors test-rust-core.yml
                // =====================================================================
                stage('Rust Core') {
                    agent {
                        docker {
                            image "universal-driver-coverage:${BUILD_NUMBER}"
                            args '-u root --privileged'
                            reuseNode true
                        }
                    }
                    stages {
                        stage('Build') {
                            steps {
                                sh '''
                                    export PARAMETER_PATH=$(pwd)/parameters.json
                                    cargo tarpaulin --packages sf_core --all-features --skip-clean --no-fail-fast --no-run --out lcov --output-dir .
                                '''
                            }
                        }
                        stage('Test') {
                            steps {
                                sh '''
                                    export PARAMETER_PATH=$(pwd)/parameters.json
                                    cargo tarpaulin --packages sf_core --all-features --skip-clean --no-fail-fast --out lcov --output-dir .
                                    mv lcov.info lcov-rust-core.info
                                '''
                            }
                        }
                        stage('Upload') {
                            steps {
                                withCredentials([
                                    string(credentialsId: 'codecov-token', variable: 'CODECOV_TOKEN')
                                ]) {
                                    sh '''
                                        codecovcli upload-process \
                                            --token "${CODECOV_TOKEN}" \
                                            --file lcov-rust-core.info \
                                            --flag rust-core \
                                            --name "rust-core-jenkins-${BUILD_NUMBER}" \
                                            --branch "${BRANCH_NAME}" \
                                            --sha "${GIT_COMMIT}" \
                                            ${CHANGE_ID:+--pr "${CHANGE_ID}"} \
                                            --verbose || echo "Warning: Upload failed"
                                    '''
                                }
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'lcov-rust-core.info', allowEmptyArchive: true
                        }
                    }
                }
                
                // =====================================================================
                // Python - mirrors test-python.yml
                // =====================================================================
                stage('Python') {
                    agent {
                        docker {
                            image "universal-driver-coverage:${BUILD_NUMBER}"
                            args '-u root --privileged'
                            reuseNode true
                        }
                    }
                    stages {
                        stage('Build Core') {
                            steps {
                                dir('python') {
                                    sh 'RUSTFLAGS="" make build-core'
                                }
                            }
                        }
                        stage('Setup') {
                            steps {
                                dir('python') {
                                    sh 'make setup'
                                }
                            }
                        }
                        stage('Test') {
                            steps {
                                dir('python') {
                                    sh '''
                                        export PARAMETER_PATH=$(pwd)/../parameters.json
                                        mkdir -p reports
                                        uv run tox -e py39-all -- \
                                            --cov=src/snowflake \
                                            --cov-report=xml:reports/coverage-python.xml
                                    '''
                                }
                            }
                        }
                        stage('Upload') {
                            steps {
                                withCredentials([
                                    string(credentialsId: 'codecov-token', variable: 'CODECOV_TOKEN')
                                ]) {
                                    sh '''
                                        if [ -f python/reports/coverage-python.xml ]; then
                                            codecovcli upload-process \
                                                --token "${CODECOV_TOKEN}" \
                                                --file python/reports/coverage-python.xml \
                                                --flag python \
                                                --name "python-jenkins-${BUILD_NUMBER}" \
                                                --branch "${BRANCH_NAME}" \
                                                --sha "${GIT_COMMIT}" \
                                                ${CHANGE_ID:+--pr "${CHANGE_ID}"} \
                                                --verbose || echo "Warning: Upload failed"
                                        else
                                            echo "Warning: Coverage file not found"
                                        fi
                                    '''
                                }
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'python/reports/coverage-python.xml', allowEmptyArchive: true
                        }
                    }
                }
                
                // =====================================================================
                // ODBC - mirrors test-odbc.yml
                // =====================================================================
                stage('ODBC') {
                    agent {
                        docker {
                            image "universal-driver-coverage:${BUILD_NUMBER}"
                            args '-u root --privileged'
                            reuseNode true
                        }
                    }
                    stages {
                        stage('Build Driver') {
                            steps {
                                sh 'RUSTFLAGS="-C instrument-coverage" cargo build'
                            }
                        }
                        stage('Build Tests') {
                            steps {
                                dir('odbc_tests') {
                                    sh '''
                                        mkdir -p cmake-build
                                        cmake -B cmake-build \
                                            -D ODBC_LIBRARY="/usr/lib64/libodbc.so" \
                                            -D ODBC_INCLUDE_DIR="/usr/include" \
                                            -D DRIVER_TYPE=NEW \
                                            .
                                        cmake --build cmake-build -- -j $(nproc)
                                    '''
                                }
                            }
                        }
                        stage('Test') {
                            steps {
                                sh '''
                                    export DRIVER_PATH=$(pwd)/target/debug/libsfodbc.so
                                    export PARAMETER_PATH=$(pwd)/parameters.json
                                    export LLVM_PROFILE_FILE="odbc-%p-%m.profraw"
                                    cd odbc_tests
                                    ctest -j $(nproc) -C Debug --test-dir cmake-build --output-on-failure
                                '''
                            }
                        }
                        stage('Generate Report') {
                            steps {
                                sh '''
                                    LLVM_PROFDATA=$(find /root/.rustup -name "llvm-profdata" -type f 2>/dev/null | head -1)
                                    LLVM_COV=$(find /root/.rustup -name "llvm-cov" -type f 2>/dev/null | head -1)
                                    find . -name "odbc-*.profraw" -type f | xargs $LLVM_PROFDATA merge -sparse -o coverage.profdata
                                    $LLVM_COV export target/debug/libsfodbc.so \
                                        -instr-profile=coverage.profdata \
                                        -format=lcov \
                                        -sources=$(pwd)/odbc \
                                        -sources=$(pwd)/sf_core > lcov-odbc.info
                                '''
                            }
                        }
                        stage('Upload') {
                            steps {
                                withCredentials([
                                    string(credentialsId: 'codecov-token', variable: 'CODECOV_TOKEN')
                                ]) {
                                    sh '''
                                        if [ -f lcov-odbc.info ]; then
                                            codecovcli upload-process \
                                                --token "${CODECOV_TOKEN}" \
                                                --file lcov-odbc.info \
                                                --flag odbc \
                                                --name "odbc-jenkins-${BUILD_NUMBER}" \
                                                --branch "${BRANCH_NAME}" \
                                                --sha "${GIT_COMMIT}" \
                                                ${CHANGE_ID:+--pr "${CHANGE_ID}"} \
                                                --verbose || echo "Warning: Upload failed"
                                        else
                                            echo "Warning: Coverage file not found"
                                        fi
                                    '''
                                }
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'lcov-odbc.info', allowEmptyArchive: true
                        }
                    }
                }
                
                // =====================================================================
                // JDBC - mirrors test-jdbc.yml
                // =====================================================================
                stage('JDBC') {
                    agent {
                        docker {
                            image "universal-driver-coverage:${BUILD_NUMBER}"
                            args '-u root --privileged'
                            reuseNode true
                        }
                    }
                    stages {
                        stage('Build') {
                            steps {
                                sh '''
                                    cargo build --package sf_core
                                    cargo build --package jdbc_bridge
                                '''
                            }
                        }
                        stage('Test') {
                            steps {
                                sh '''
                                    export PARAMETER_PATH=$(pwd)/parameters.json
                                    export CORE_PATH=$(pwd)/target/debug/libjdbc_bridge.so
                                    chmod +x jdbc/gradlew
                                    cd jdbc
                                    ./gradlew test jacocoTestReport --stacktrace
                                '''
                            }
                        }
                        stage('Upload') {
                            steps {
                                withCredentials([
                                    string(credentialsId: 'codecov-token', variable: 'CODECOV_TOKEN')
                                ]) {
                                    sh '''
                                        if [ -f jdbc/build/reports/jacoco/test/jacocoTestReport.xml ]; then
                                            codecovcli upload-process \
                                                --token "${CODECOV_TOKEN}" \
                                                --file jdbc/build/reports/jacoco/test/jacocoTestReport.xml \
                                                --flag jdbc \
                                                --name "jdbc-jenkins-${BUILD_NUMBER}" \
                                                --branch "${BRANCH_NAME}" \
                                                --sha "${GIT_COMMIT}" \
                                                ${CHANGE_ID:+--pr "${CHANGE_ID}"} \
                                                --verbose || echo "Warning: Upload failed"
                                        else
                                            echo "Warning: Coverage file not found"
                                        fi
                                    '''
                                }
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'jdbc/build/reports/jacoco/test/jacocoTestReport.xml', allowEmptyArchive: true
                        }
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo '✓ All coverage reports uploaded to Codecov'
        }
        failure {
            echo '✗ Coverage pipeline failed'
        }
    }
}
