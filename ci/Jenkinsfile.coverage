/*
 * Jenkinsfile for code coverage generation and upload to Codecov
 */

pipeline {
    agent none
    
    options {
        timestamps()
        disableResume()
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '100'))
        timeout(time: 2, unit: 'HOURS')
    }
    
    triggers {
        cron(env.BRANCH_NAME == 'main' ? 'H 2 * * *' : '')
    }
    
    stages {
        stage('Coverage') {
            parallel {
                stage('Rust Core') {
                    agent {
                        dockerfile {
                            filename 'Dockerfile.coverage'
                            dir 'ci'
                            args '-u root --privileged'
                            label 'build-node-extra-large'
                        }
                    }
                    steps {
                        // Setup
                        sh 'echo "=== Setup ==="'
                        withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                            sh './scripts/decode_secrets.sh'
                        }
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                set -e
                                if [ -z "${CODECOV_TOKEN}" ]; then
                                    echo "ERROR: CODECOV_TOKEN is empty!"
                                    exit 1
                                fi
                                echo "CODECOV_TOKEN is set (length: $(echo -n "${CODECOV_TOKEN}" | wc -c) chars)"
                            '''
                        }
                        
                        // Test + Coverage (tarpaulin prints coverage summary automatically)
                        sh '''
                            set +x
                            echo "=== Test + Coverage ==="
                            export PARAMETER_PATH=$(pwd)/parameters.json
                            cargo tarpaulin --packages sf_core --all-features --skip-clean --no-fail-fast --out lcov --output-dir .
                            mv lcov.info lcov-rust-core.info
                            echo ""
                            echo "=== Coverage Report Saved: lcov-rust-core.info ==="
                        '''
                        
                        // Upload to Codecov
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                echo "=== Uploading to Codecov ==="
                                codecovcli --verbose upload-process \
                                    --disable-search \
                                    --fail-on-error \
                                    -t "${CODECOV_TOKEN}" \
                                    -n "rust-core-jenkins-${BUILD_NUMBER}" \
                                    -F rust-core \
                                    -f lcov-rust-core.info
                            '''
                        }
                        
                        archiveArtifacts artifacts: 'lcov-rust-core.info', allowEmptyArchive: true
                    }
                }
                
                stage('Python') {
                    agent {
                        dockerfile {
                            filename 'Dockerfile.coverage'
                            dir 'ci'
                            args '-u root --privileged'
                            label 'build-node-extra-large'
                        }
                    }
                    steps {
                        // Setup
                        sh 'echo "=== Setup ==="'
                        withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                            sh './scripts/decode_secrets.sh'
                        }
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                set -e
                                if [ -z "${CODECOV_TOKEN}" ]; then
                                    echo "ERROR: CODECOV_TOKEN is empty!"
                                    exit 1
                                fi
                                echo "CODECOV_TOKEN is set (length: $(echo -n "${CODECOV_TOKEN}" | wc -c) chars)"
                            '''
                        }
                        
                        // Build
                        dir('python') {
                            sh '''
                                set +x
                                echo "=== Build ==="
                                RUSTFLAGS="" make build-core
                                make setup
                            '''
                        }
                        
                        // Test + Coverage (added --cov-report=term for console output)
                        dir('python') {
                            sh '''
                                set +x
                                echo "=== Test + Coverage ==="
                                export PARAMETER_PATH=$(pwd)/../parameters.json
                                mkdir -p reports
                                uv run tox -e py39-all -- \
                                    --cov=src/snowflake \
                                    --cov-report=term \
                                    --cov-report=xml:reports/coverage-python.xml
                                echo ""
                                echo "=== Coverage Report Saved: python/reports/coverage-python.xml ==="
                            '''
                        }
                        
                        // Upload to Codecov
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                echo "=== Uploading to Codecov ==="
                                codecovcli --verbose upload-process \
                                    --disable-search \
                                    --fail-on-error \
                                    -t "${CODECOV_TOKEN}" \
                                    -n "python-jenkins-${BUILD_NUMBER}" \
                                    -F python \
                                    -f python/reports/coverage-python.xml
                            '''
                        }
                        
                        archiveArtifacts artifacts: 'python/reports/coverage-python.xml', allowEmptyArchive: true
                    }
                }
                
                stage('ODBC') {
                    agent {
                        dockerfile {
                            filename 'Dockerfile.coverage'
                            dir 'ci'
                            args '-u root --privileged'
                            label 'build-node-extra-large'
                        }
                    }
                    steps {
                        // Setup
                        sh 'echo "=== Setup ==="'
                        withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                            sh './scripts/decode_secrets.sh'
                        }
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                set -e
                                if [ -z "${CODECOV_TOKEN}" ]; then
                                    echo "ERROR: CODECOV_TOKEN is empty!"
                                    exit 1
                                fi
                                echo "CODECOV_TOKEN is set (length: $(echo -n "${CODECOV_TOKEN}" | wc -c) chars)"
                            '''
                        }
                        
                        // Build
                        sh '''
                            set +x
                            echo "=== Build ==="
                            RUSTFLAGS="-C instrument-coverage" cargo build
                            source /opt/rh/gcc-toolset-11/enable
                            cd odbc_tests
                            mkdir -p cmake-build
                            cmake -B cmake-build \
                                -D ODBC_LIBRARY="/usr/lib64/libodbc.so" \
                                -D ODBC_INCLUDE_DIR="/usr/include" \
                                -D DRIVER_TYPE=NEW \
                                .
                            cmake --build cmake-build -- -j $(nproc)
                        '''
                        
                        // Test
                        sh '''
                            set +x
                            echo "=== Test ==="
                            export DRIVER_PATH=$(pwd)/target/debug/libsfodbc.so
                            export PARAMETER_PATH=$(pwd)/parameters.json
                            export LLVM_PROFILE_FILE="odbc-%p-%m.profraw"
                            
                            # Enable ODBC Tracing
                            echo "[ODBC]" > odbcinst.ini
                            echo "Trace = yes" >> odbcinst.ini
                            echo "TraceFile = $(pwd)/sql.log" >> odbcinst.ini
                            export ODBCSYSINI=$(pwd)
                            
                            cd odbc_tests
                            set +e # Allow tests to fail so we can print the log
                            ctest -j 1 -C Debug --test-dir cmake-build --output-on-failure -E "crl"
                            TEST_EXIT_CODE=$?
                            set -e
                            
                            if [ $TEST_EXIT_CODE -ne 0 ]; then
                                echo "=== ODBC Trace (Last 100 lines) ==="
                                tail -n 100 ../sql.log || true
                                echo "=== End Trace ==="
                                exit $TEST_EXIT_CODE
                            fi
                        '''
                        
                        // Coverage (added report summary)
                        sh '''
                            set +x
                            echo "=== Coverage ==="
                            LLVM_PROFDATA=$(find /root/.rustup -name "llvm-profdata" -type f 2>/dev/null | head -1)
                            LLVM_COV=$(find /root/.rustup -name "llvm-cov" -type f 2>/dev/null | head -1)
                            find . -name "odbc-*.profraw" -type f | xargs $LLVM_PROFDATA merge -sparse -o coverage.profdata
                            
                            echo ""
                            echo "=== Coverage Summary ==="
                            $LLVM_COV report target/debug/libsfodbc.so \
                                -instr-profile=coverage.profdata \
                                -sources=$(pwd)/odbc \
                                -sources=$(pwd)/sf_core
                            
                            echo ""
                            echo "=== Generating LCOV Report ==="
                            $LLVM_COV export target/debug/libsfodbc.so \
                                -instr-profile=coverage.profdata \
                                -format=lcov \
                                -sources=$(pwd)/odbc \
                                -sources=$(pwd)/sf_core > lcov-odbc.info
                            echo "=== Coverage Report Saved: lcov-odbc.info ==="
                        '''
                        
                        // Upload to Codecov
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                echo "=== Uploading to Codecov ==="
                                codecovcli --verbose upload-process \
                                    --disable-search \
                                    --fail-on-error \
                                    -t "${CODECOV_TOKEN}" \
                                    -n "odbc-jenkins-${BUILD_NUMBER}" \
                                    -F odbc \
                                    -f lcov-odbc.info
                            '''
                        }
                        
                        archiveArtifacts artifacts: 'lcov-odbc.info', allowEmptyArchive: true
                    }
                }
                
                stage('JDBC') {
                    agent {
                        dockerfile {
                            filename 'Dockerfile.coverage'
                            dir 'ci'
                            args '-u root --privileged'
                            label 'build-node-extra-large'
                        }
                    }
                    steps {
                        // Setup
                        sh 'echo "=== Setup ==="'
                        withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                            sh './scripts/decode_secrets.sh'
                        }
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                set -e
                                if [ -z "${CODECOV_TOKEN}" ]; then
                                    echo "ERROR: CODECOV_TOKEN is empty!"
                                    exit 1
                                fi
                                echo "CODECOV_TOKEN is set (length: $(echo -n "${CODECOV_TOKEN}" | wc -c) chars)"
                            '''
                        }
                        
                        // Build
                        sh '''
                            set +x
                            echo "=== Build ==="
                            cargo build --package sf_core
                            cargo build --package jdbc_bridge
                        '''
                        
                        // Test + Coverage
                        sh '''
                            set +x
                            echo "=== Test + Coverage ==="
                            export PARAMETER_PATH=$(pwd)/parameters.json
                            export CORE_PATH=$(pwd)/target/debug/libjdbc_bridge.so
                            chmod +x jdbc/gradlew
                            cd jdbc
                            ./gradlew test jacocoTestReport --stacktrace
                        '''
                        
                        // Print coverage summary from JaCoCo XML
                        sh '''
                            set +x
                            echo ""
                            echo "=== Coverage Summary ==="
                            REPORT="jdbc/build/reports/jacoco/test/jacocoTestReport.xml"
                            if [ -f "$REPORT" ]; then
                                # Extract line coverage from JaCoCo XML
                                # Use || true to prevent script failure if grep finds nothing
                                MISSED=$(grep -o 'type="LINE" missed="[0-9]*"' "$REPORT" | head -1 | grep -o '[0-9]*' || echo "0")
                                COVERED=$(grep -o 'type="LINE" covered="[0-9]*"' "$REPORT" | head -1 | grep -o '[0-9]*' || echo "0")
                                
                                # Convert to integers
                                MISSED_INT=${MISSED:-0}
                                COVERED_INT=${COVERED:-0}
                                TOTAL=$((MISSED_INT + COVERED_INT))
                                
                                if [ "$TOTAL" -gt 0 ]; then
                                    PERCENT=$((COVERED_INT * 100 / TOTAL))
                                    echo "Line Coverage: ${PERCENT}% (${COVERED_INT}/${TOTAL} lines)"
                                else
                                    echo "No coverage data found in report"
                                fi
                                echo "Full report: jdbc/build/reports/jacoco/test/html/index.html"
                            else
                                echo "Coverage report not found"
                            fi
                            echo "=== Coverage Report Saved: jdbc/build/reports/jacoco/test/jacocoTestReport.xml ==="
                        '''
                        
                        // Upload to Codecov
                        withCredentials([
                            fuseString(variable: 'CODECOV_TOKEN', encryptedSecret: 'sf-crypt://universes/prod/services/jenkins/locations/sfc-or-dev-ci-k8s-ci1/secrets/jenkins/ctlr/dev/snowdrivers/ud_repo_codecov/d17dfc2e-875b-4320-8a18-b4efd0631a70:AQAAAVcKOnNmYy1vci1kZXYtY2ktazhzLWNpMS9jMTJhYTQxNi1jOWU5LTRlMmUtYmQzZi01Y2M0NTdlMjBmYWIS1AFTfr2leAaIicr-MxHW71TJ0awbKWoWmoljufftopa4ooW1HNYQruhogw-DnUn6cNtUvkOPbq9DQtD2cKX_8vPizn58xCQQeBQuvPI2cNgLHvaMTcPWP-FKaLUj7nnDyhpGJyQNsFUMPPlEjh0wuJsg5JdDiks-x2_kwbG66iYT6s9qhZmmwhWtIINIhB1lw4ObK5uK7G7T72fd30sjcHrAJEC8gso2_m1sq94tQPVm4-TGxigEKRFJCwuE9T6kX1GORDxHO9hyLHWI102FR-arqLuaJBg0IkAdo4DVN7eooSCn55O4C8W1SXNJOaANNpJCTYXvJ0LV4fP3mpFOTzZ2HBktEvfaERZoYtsWIOy09mHnziJgdVJqo-5QJya-m5YWyzCB0VpPhwDTXvCkZRME6tGQW6F-Cg9ZK-QBYy85I5YbCop0VcH0P_6iFywtaJ3M6j-C8oHCmRSIz84=')
                        ]) {
                            sh '''
                                set +x
                                echo "=== Uploading to Codecov ==="
                                codecovcli --verbose upload-process \
                                    --disable-search \
                                    --fail-on-error \
                                    -t "${CODECOV_TOKEN}" \
                                    -n "jdbc-jenkins-${BUILD_NUMBER}" \
                                    -F jdbc \
                                    -f jdbc/build/reports/jacoco/test/jacocoTestReport.xml
                            '''
                        }
                        
                        archiveArtifacts artifacts: 'jdbc/build/reports/jacoco/test/jacocoTestReport.xml', allowEmptyArchive: true
                    }
                }
            }
        }
    }
}
