/*
Jenkinsfile for authentication E2E tests requiring a headless browser.
Runs inside the snowdrivers-test-external-browser-universal-driver Docker image
which provides headless Chromium + Playwright + Rust + Python.

Local usage (requires parameters_preprod.json in repo root):
  ./scripts/decode_secrets.sh preprod parameters_preprod.json
  DOCKER_IMAGE=<image> ./tests/auth/run_auth_browser.sh python
  DOCKER_IMAGE=<image> ./tests/auth/run_auth_browser.sh odbc
  DOCKER_IMAGE=<image> ./tests/auth/run_auth_browser.sh jdbc

Or build & run locally without a pre-built image:
  ./tests/auth/run_auth_browser_local.sh python
*/

@Library('pipeline-utils') _
import groovy.transform.Field
import com.snowflake.DevEnvUtils

@Field String AUTH_BROWSER_DOCKER_IMAGE = 'artifactory.ci1.us-west-2.aws-dev.app.snowflake.com/internal-development-docker-drivers-local/snowflakedb/snowdrivers-test-external-browser-universal-driver:4'

def isMergeQueue() {
  return env.BRANCH_NAME?.startsWith('gh-readonly-queue/')
}

@Field def runPython = false
@Field def runOdbc = false
@Field def runJdbc = false

def detectChanges() {
  // For main branch builds (and cron), run everything.
  if (env.CHANGE_ID == null) {
    runPython = true
    runOdbc = true
    runJdbc = true
    return
  }

  def changedFiles = sh(
    returnStdout: true,
    script: "git diff --name-only origin/${env.CHANGE_TARGET}...HEAD"
  ).trim().split('\n').toList()

  echo "Changed files (${changedFiles.size()}):"
  changedFiles.each { echo "  ${it}" }

  // Shared Rust core — affects sf_core compilation, which the Python connector, the ODBC driver,
  // and the JDBC bridge all build from source. Include the workspace-level deps of sf_core.
  def corePatterns = [
    'sf_core/', 'proto_utils/', 'error_trace/', 'error_trace_derive/', 'proto_generator/',
    'Cargo.lock', 'rust-toolchain.toml',
  ]

  for (file in changedFiles) {
    if (corePatterns.any { file.startsWith(it) || file == it }) {
      runPython = true
      runOdbc = true
      runJdbc = true
      break
    }
    // Job definition or the shared container scripts affect all wrappers.
    if (file == 'ci/Jenkinsfile.auth-browser-tests' ||
        file.startsWith('tests/auth/')) {
      runPython = true
      runOdbc = true
      runJdbc = true
    }
    // The Python connector / tests.
    if (file.startsWith('python/') ||
        file.startsWith('pep249_dbapi/')) {
      runPython = true
    }
    // The ODBC driver / tests.
    if (file.startsWith('odbc/') ||
        file.startsWith('odbc_tests/')) {
      runOdbc = true
    }
    // The JDBC driver / bridge / tests.
    if (file.startsWith('jdbc/') ||
        file.startsWith('jdbc_bridge/')) {
      runJdbc = true
    }
  }

  echo "=== Auth Browser Tests Change Detection ==="
  echo "  Run Python: ${runPython}"
  echo "  Run ODBC: ${runOdbc}"
  echo "  Run JDBC: ${runJdbc}"
}

def authenticateDocker() {
  new DevEnvUtils().withSfCli {
    sh "sf artifact oci auth"
  }
}

pipeline {
  agent none
  options {
    timestamps()
    disableResume()
    // Different pushes to this same PR (or branch) must not run concurrently — an older,
    // now-superseded build would otherwise keep hammering the shared MFA test accounts
    // (see the lock() below) even after a newer push has made its result moot.
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(daysToKeepStr: '5', numToKeepStr: '50'))
    timeout(time: 1, unit: 'HOURS')
  }
  triggers {
    cron(env.BRANCH_NAME == 'main' ? 'H H/6 * * *' : '')
  }
  stages {
    stage('Detect Changes') {
      agent { label 'build-node-extra-large' }
      steps {
        checkout scm
        script { detectChanges() }
      }
    }

    stage('Auth Browser Tests') {
      when {
        expression { !isMergeQueue() }
      }
      options {
        // This is a multibranch job: disableConcurrentBuilds() above only serializes builds
        // of the SAME branch/PR. Different PRs (and main's own cron trigger) are separate job
        // instances and would otherwise run this stage fully concurrently, hitting the same
        // shared, rate-limited Snowflake MFA test accounts at once - the exact class of bug
        // this stage's own sequential stages{} already fixes within one build, just recurring
        // across builds instead. This resource name is shared by every trigger of this
        // Jenkinsfile (any PR, any branch, the main cron), so at most one of them is ever
        // actually running MFA tests at a time. inversePrecedence: true means a freshly-queued
        // build jumps ahead of older queued ones on the same resource.
        lock(resource: 'drivers-auth-browser-shared-mfa-accounts', inversePrecedence: true)
      }
      // Sequential instead of parallel: Python/ODBC/JDBC all share one OAuth AC-flow test
      // account and its one TOTP seed (SNOWFLAKE_TEST_OAUTH_SNOWFLAKE_MFA_SEED); running their
      // real MFA verifications concurrently lets one stage's code collide with another's
      // still-valid one, which Snowflake's anti-replay check then rejects - the JDBC stage's
      // oauthShouldReuseCachedAccessTokenWithoutBrowserInteraction failure in builds #7/#8
      // traced to exactly this. Serializing removes the possibility of a collision outright.
      // Keep sequential until a less costly mitigation exists (e.g. per-language TOTP seed).
      stages {
        stage('Python') {
          when {
            expression { runPython }
          }
          agent { label 'build-node-extra-large' }
          stages {
            stage('Setup') {
              steps {
                script {
                  authenticateDocker()
                  withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                    sh label: 'Decode Secrets', script: './scripts/decode_secrets.sh preprod parameters_preprod.json'
                  }
                }
              }
            }
            stage('Universal') {
              steps {
                sh label: 'Run Python auth browser tests (universal)', script: "DOCKER_IMAGE=${AUTH_BROWSER_DOCKER_IMAGE} ./tests/auth/run_auth_browser.sh python universal"
              }
            }
            stage('Reference') {
              steps {
                sh label: 'Run Python auth browser tests (reference)', script: "DOCKER_IMAGE=${AUTH_BROWSER_DOCKER_IMAGE} ./tests/auth/run_auth_browser.sh python reference"
              }
            }
          }
        }
        stage('ODBC') {
          when {
            expression { runOdbc }
          }
          agent { label 'build-node-extra-large' }
          stages {
            stage('Setup') {
              steps {
                script {
                  authenticateDocker()
                  withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                    sh label: 'Decode Secrets', script: './scripts/decode_secrets.sh preprod parameters_preprod.json'
                  }
                }
              }
            }
            stage('Universal') {
              steps {
                sh label: 'Run ODBC auth browser tests (universal)', script: "DOCKER_IMAGE=${AUTH_BROWSER_DOCKER_IMAGE} ./tests/auth/run_auth_browser.sh odbc universal"
              }
            }
            stage('Reference') {
              steps {
                sh label: 'Run ODBC auth browser tests (reference)', script: "DOCKER_IMAGE=${AUTH_BROWSER_DOCKER_IMAGE} ./tests/auth/run_auth_browser.sh odbc reference"
              }
            }
          }
        }
        stage('JDBC') {
          when {
            expression { runJdbc }
          }
          agent { label 'build-node-extra-large' }
          stages {
            stage('Setup') {
              steps {
                script {
                  authenticateDocker()
                  withCredentials([string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')]) {
                    sh label: 'Decode Secrets', script: './scripts/decode_secrets.sh preprod parameters_preprod.json'
                  }
                }
              }
            }
            stage('Universal') {
              steps {
                sh label: 'Run JDBC auth browser tests (universal)', script: """
                  DOCKER_IMAGE=${AUTH_BROWSER_DOCKER_IMAGE} \\
                  DOCKER_RUN_EXTRA_ARGS='-e JENKINS_HOME' \\
                  ./tests/auth/run_auth_browser.sh jdbc universal
                """
              }
            }
            stage('Reference') {
              steps {
                sh label: 'Run JDBC auth browser tests (reference)', script: """
                  DOCKER_IMAGE=${AUTH_BROWSER_DOCKER_IMAGE} \\
                  DOCKER_RUN_EXTRA_ARGS='-e JENKINS_HOME' \\
                  ./tests/auth/run_auth_browser.sh jdbc reference
                """
              }
            }
          }
        }
      }
    }
  }
}
