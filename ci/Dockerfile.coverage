# Dockerfile for code coverage builds
# Contains all dependencies for: Rust Core, Python, ODBC, JDBC
# Based on Rocky Linux 8 (same as Dockerfile.rocky)

FROM rockylinux:8

# Install base development tools
RUN dnf install -y \
    gcc \
    gcc-c++ \
    make \
    tar \
    gzip \
    curl \
    wget \
    bash \
    git \
    which \
    findutils \
    openssl-devel \
    perl-IPC-Cmd

# Install EPEL for additional packages
RUN dnf install -y epel-release && dnf install -y awscli

# ============================================================
# Python (for Python driver tests)
# ============================================================
RUN dnf install -y python39 python39-pip python39-devel && \
    alternatives --set python3 /usr/bin/python3.9 && \
    pip3 install --upgrade pip setuptools wheel uv

# ============================================================
# Java 8 (for JDBC tests)
# ============================================================
RUN dnf install -y java-1.8.0-openjdk java-1.8.0-openjdk-devel
ENV JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk

# ============================================================
# ODBC (for ODBC tests)
# ============================================================
RUN dnf install -y unixODBC unixODBC-devel zlib-devel

# Install CMake 4.0+ (required by ODBC tests)
RUN curl -L https://github.com/Kitware/CMake/releases/download/v4.0.0/cmake-4.0.0-linux-x86_64.sh -o /tmp/cmake.sh && \
    sh /tmp/cmake.sh --skip-license --prefix=/usr/local && \
    rm /tmp/cmake.sh

# ============================================================
# Go (required by aws-lc-fips-sys for FIPS-compliant crypto)
# ============================================================
RUN curl -L https://go.dev/dl/go1.22.5.linux-amd64.tar.gz | tar -C /usr/local -xzf -
ENV PATH="/usr/local/go/bin:${PATH}"

# ============================================================
# Rust (shared by all components)
# ============================================================
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    rustup component add llvm-tools-preview && \
    cargo install cargo-tarpaulin

# ============================================================
# Codecov CLI (for uploading coverage)
# ============================================================
# Install via pip because the standalone binary requires GLIBC 2.29+ (Rocky 8 has 2.28)
RUN pip3 install codecov-cli

# Verify installations
# Note: cmake --version skipped as it may fail under Rosetta on Apple Silicon
RUN rustc --version && \
    cargo --version && \
    python3 --version && \
    java -version && \
    go version && \
    codecovcli --version
