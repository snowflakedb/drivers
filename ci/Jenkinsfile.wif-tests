@Library('pipeline-utils') _
import groovy.transform.Field
import com.snowflake.DevEnvUtils

// Coverage image carries the Rust toolchain + C/C++ build deps. We build the
// WIF e2e binary here, then ship it to the bare WIF cloud VMs (which have no
// toolchain) and run it there in a public runtime container.
def E2E_DOCKER_IMAGE = 'artifactory.ci1.us-west-2.aws-dev.app.snowflake.com/internal-production-docker-snowflake-virtual/docker/rhel8-universal-driver-coverage:3'
// Node napi needs Node + Rust in one image. The coverage image has no Node;
// the external-browser image has both. Runtime on the VM is still public
// node:22-slim (see tests/auth/run_wif.sh).
def NODEJS_DOCKER_IMAGE = 'artifactory.ci1.us-west-2.aws-dev.app.snowflake.com/internal-development-docker-drivers-local/snowflakedb/snowdrivers-test-external-browser-universal-driver:4'

@Field String FULL_AUTH_SUITE_LABEL = 'run_full_auth_tests'
// One WIF VM per cloud for the org; lanes hold this for the whole three-cloud run.
@Field String WIF_VM_LOCK = 'drivers-wif-cloud-vms'
@Field boolean runSfCore = false
@Field boolean runNodejs = false

def isMergeQueue() {
  return env.BRANCH_NAME?.startsWith('gh-readonly-queue/')
}

boolean prHasLabel(String name) {
  if (env.CHANGE_ID == null) {
    return false
  }
  try {
    return pullRequest.labels.contains(name)
  } catch (Throwable ignored) {
    echo "Could not read pullRequest.labels; treating '${name}' as absent"
    return false
  }
}

def runAllLanes(String reason) {
  runSfCore = true
  runNodejs = true
  echo "Running the full WIF suite: ${reason}"
}

// Decide which WIF language lanes should occupy the cloud VMs.
//
// main / non-PR: both lanes (same as VPN, auth-browser, uSUT, build-matrix).
// Merge-queue: skipped by the stage `when`.
// `run_full_auth_tests` label: both lanes.
// Empty diff: both lanes (force-push race or missing target fetch).
// PRs: sf_core and Node.js independently, from the paths each lane builds.
def detectChanges() {
  if (env.CHANGE_ID == null) {
    runAllLanes("non-PR build of ${env.BRANCH_NAME}")
    return
  }
  if (prHasLabel(FULL_AUTH_SUITE_LABEL)) {
    runAllLanes("${FULL_AUTH_SUITE_LABEL} label on the PR")
    return
  }

  def changedFiles = sh(
    returnStdout: true,
    script: "git diff --name-only origin/${env.CHANGE_TARGET}...HEAD"
  ).trim().split('\n').findAll { it }.toList()

  echo "Changed files (${changedFiles.size()}):"
  changedFiles.each { echo "  ${it}" }

  if (changedFiles.isEmpty()) {
    runAllLanes('Empty changeset — running both WIF lanes to be safe.')
    return
  }

  def bothLanePatterns = [
    'sf_core/',
    'sf_params_spec/',
    'sf_params_codegen/',
    'proto_utils/',
    'proto_generator/',
    'protobuf/',
    'thrift/',
    'error_trace/',
    'error_trace_derive/',
    'ci/Jenkinsfile.wif-tests',
    'ci/setup_gpg_home.sh',
    'scripts/decode_secrets.sh',
    'tests/auth/run_wif.sh',
    'tests/auth/wif/',
    'tests/definitions/shared/authentication/workload_identity.feature',
    'Cargo.toml',
    'Cargo.lock',
    'rust-toolchain.toml',
    'build_common.rs',
  ]
  def sfCoreOnlyPatterns = [
    'tests/auth/build_wif_sf_core_artifacts.sh',
    'tests/auth/wif_run_sf_core_in_container.sh',
  ]
  def nodejsOnlyPatterns = [
    'nodejs/',
    'nodejs_bridge/',
    'tests/auth/build_wif_nodejs_artifacts.sh',
    'tests/auth/run_wif_local.sh',
    'tests/auth/wif_nodejs_artifact_validation.sh',
    'tests/auth/wif_run_nodejs_in_container.sh',
    'tests/docker/wif-nodejs/',
  ]

  changedFiles.each { f ->
    if (bothLanePatterns.any { p -> f == p || f.startsWith(p) }) {
      runSfCore = true
      runNodejs = true
    }
    if (sfCoreOnlyPatterns.any { p -> f == p || f.startsWith(p) }) {
      runSfCore = true
    }
    if (nodejsOnlyPatterns.any { p -> f == p || f.startsWith(p) }) {
      runNodejs = true
    }
  }

  echo '=== WIF Tests Change Detection ==='
  echo "  Run sf_core: ${runSfCore}"
  echo "  Run Node.js: ${runNodejs}"
}

def e2eDockerSetup(String image) {
  new DevEnvUtils().withSfCli {
    sh "sf artifact oci auth"
  }
  sh label: 'Docker Pull', script: "docker pull ${image}"
}

pipeline {
  agent none
  options {
    timestamps()
    disableResume()
    // A superseded build would otherwise keep occupying the three shared WIF
    // VMs (see WIF_VM_LOCK) while a newer push has already made its result moot.
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(daysToKeepStr: '5', numToKeepStr: '50'))
    // Includes time spent waiting for WIF_VM_LOCK, which the lanes now queue on.
    timeout(time: 2, unit: 'HOURS')
  }
  stages {
    stage('Detect Changes') {
      when {
        beforeAgent true
        expression { !isMergeQueue() }
      }
      agent { label 'small-node-c7' }
      steps {
        checkout scm
        script {
          detectChanges()
        }
      }
    }

    stage('WIF E2E') {
      when {
        beforeAgent true
        allOf {
          expression { !isMergeQueue() }
          expression { runSfCore || runNodejs }
        }
      }
      parallel {
        stage('sf_core') {
          when {
            beforeAgent true
            expression { runSfCore }
          }
          agent { label 'parallelizable-snowos' }
          stages {
            stage('Checkout') {
              steps {
                script {
                  def scmInfo = checkout scm
                  env.GIT_BRANCH = scmInfo.GIT_BRANCH
                  env.GIT_COMMIT = scmInfo.GIT_COMMIT
                }
              }
            }
            stage('Build') {
              steps {
                script {
                  e2eDockerSetup(E2E_DOCKER_IMAGE)
                  docker.image(E2E_DOCKER_IMAGE).inside('-u root') {
                    // Rocky Linux rotates dnf metadata hashes weekly, which breaks
                    // pre-built images shipping stale caches. Refresh before installing.
                    sh label: 'Refresh dnf metadata', script: 'dnf clean all && dnf makecache --refresh -y'
                    // jq parses cargo's --message-format=json output; unzip extracts the
                    // protoc release the sf_core build script downloads; the perl-* modules
                    // are required by openssl-src's Configure when building vendored
                    // OpenSSL 3.x from source (Time::Piece, IPC::Cmd, Data::Dumper).
                    sh label: 'Install build deps', script: 'yum install -y jq unzip perl-Time-Piece perl-IPC-Cmd perl-Data-Dumper'
                    sh label: 'Build WIF test binary', script: '$WORKSPACE/tests/auth/build_wif_sf_core_artifacts.sh'
                  }
                }
              }
            }
            stage('Test') {
              steps {
                lock(WIF_VM_LOCK) {
                  withCredentials([
                    string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')
                  ]) {
                    sh label: 'Decode Secrets', script: '$WORKSPACE/scripts/decode_secrets.sh wif'
                  }
                  sh label: 'Test WIF (sf_core)', script: '$WORKSPACE/tests/auth/run_wif.sh sf_core'
                }
              }
            }
          }
        }
        stage('nodejs') {
          when {
            beforeAgent true
            expression { runNodejs }
          }
          agent { label 'parallelizable-snowos' }
          stages {
            stage('Checkout') {
              steps {
                script {
                  def scmInfo = checkout scm
                  env.GIT_BRANCH = scmInfo.GIT_BRANCH
                  env.GIT_COMMIT = scmInfo.GIT_COMMIT
                }
              }
            }
            stage('Build') {
              steps {
                script {
                  e2eDockerSetup(NODEJS_DOCKER_IMAGE)
                  docker.image(NODEJS_DOCKER_IMAGE).inside('-u root') {
                    sh label: 'Build Node.js WIF artifact', script: '$WORKSPACE/tests/auth/build_wif_nodejs_artifacts.sh'
                  }
                }
              }
            }
            stage('Universal') {
              steps {
                lock(WIF_VM_LOCK) {
                  withCredentials([
                    string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')
                  ]) {
                    sh label: 'Decode Secrets', script: '$WORKSPACE/scripts/decode_secrets.sh wif'
                  }
                  sh label: 'Test WIF (nodejs universal)', script: '$WORKSPACE/tests/auth/run_wif.sh nodejs'
                }
              }
            }
            stage('Reference') {
              steps {
                lock(WIF_VM_LOCK) {
                  withCredentials([
                    string(credentialsId: 'sfctest0-parameters-secret', variable: 'PARAMETERS_SECRET')
                  ]) {
                    sh label: 'Decode Secrets', script: '$WORKSPACE/scripts/decode_secrets.sh wif'
                  }
                  sh label: 'Test WIF (nodejs reference)', script: '$WORKSPACE/tests/auth/run_wif.sh nodejs --reference'
                }
              }
            }
          }
        }
      }
    }
  }
}
