# Docker image for CI: build the ODBC driver and package it as a deb and a
# tarball via `odbc/installer/unix/package.sh` and fpm.
#
# The base is Debian 12, so the driver links this distro's glibc. The default
# image keeps Debian's GCC. `--build-arg FIPS=1` builds GCC 13.4.0 against
# that glibc and installs Go 1.25. `aws-lc-fips-sys` needs both. The FIPS
# package job selects that compiler.

FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip \
        build-essential cmake lld pkg-config perl \
        libssl-dev unixodbc-dev \
        ruby ruby-dev dpkg-dev tar gzip && \
    rm -rf /var/lib/apt/lists/*

RUN gem install --no-document fpm

# Debian 12 ships GCC 12. bookworm-backports does not publish gcc-13, and
# Debian 13's gcc-13 13.3.0-16 package depends on libc6 >= 2.38. This image
# builds GCC 13.4.0 from the GNU release against Debian 12's glibc, with
# bootstrap disabled so the build is one stage. Go 1.25 is the crate's other
# toolchain. The image checksums both upstream tarballs.
ARG FIPS=0
ARG GO_VERSION=1.25.14
ARG GCC_VERSION=13.4.0
RUN if [ "$FIPS" = "1" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            gawk libgmp-dev libmpfr-dev libmpc-dev zlib1g-dev xz-utils && \
        rm -rf /var/lib/apt/lists/* && \
        GCC_SHA=9c4ce6dbb040568fdc545588ac03c5cbc95a8dbf0c7aa490170843afb59ca8f5 && \
        curl --retry 5 --retry-all-errors --retry-delay 5 -fsSL "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" -o /tmp/gcc.tar.xz && \
        echo "${GCC_SHA}  /tmp/gcc.tar.xz" | sha256sum -c - && \
        tar -C /tmp -xJf /tmp/gcc.tar.xz && \
        rm /tmp/gcc.tar.xz && \
        mkdir /tmp/gcc-build && \
        cd /tmp/gcc-build && \
        "/tmp/gcc-${GCC_VERSION}/configure" \
            --prefix=/usr/local \
            --program-suffix=-13 \
            --enable-languages=c,c++ \
            --disable-bootstrap \
            --disable-multilib \
            --disable-nls \
            --disable-libsanitizer \
            --with-system-zlib && \
        make -j"$(nproc)" && \
        make install && \
        cd / && \
        rm -rf /tmp/gcc-build "/tmp/gcc-${GCC_VERSION}" && \
        gcc-13 --version && \
        g++-13 --version && \
        case "$(uname -m)" in \
            x86_64) GO_SHA=a21ae5633a269bcd7e90cf767e48225633795e99d831742cbf3397064fee7712; GO_ARCH=amd64 ;; \
            aarch64) GO_SHA=9bf234ea70ffec9347fdf6b22ce4add51717d3386a38a441e8c8743fceb5eaee; GO_ARCH=arm64 ;; \
            *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;; \
        esac && \
        curl --retry 5 --retry-all-errors --retry-delay 5 -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tgz && \
        echo "${GO_SHA}  /tmp/go.tgz" | sha256sum -c - && \
        rm -rf /usr/local/go && \
        tar -C /usr/local -xzf /tmp/go.tgz && \
        rm /tmp/go.tgz && \
        ln -sf /usr/local/go/bin/go /usr/local/bin/go && \
        go version; \
    fi

ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
