<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0;net472;net481</TargetFrameworks>
    <RootNamespace>Snowflake.Data.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SfCoreRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</SfCoreRepoRoot>
    <SfCoreTargetDir Condition="'$(CARGO_TARGET_DIR)' != ''">$([MSBuild]::NormalizeDirectory('$(SfCoreRepoRoot)', '$(CARGO_TARGET_DIR)'))</SfCoreTargetDir>
    <SfCoreTargetDir Condition="'$(SfCoreTargetDir)' == ''">$(SfCoreRepoRoot)target/</SfCoreTargetDir>
    <SfCoreCargoTargetArg Condition="'$(SfCoreCargoTarget)' != ''">--target $(SfCoreCargoTarget)</SfCoreCargoTargetArg>
    <SfCoreLibDir>$([MSBuild]::NormalizeDirectory('$(SfCoreTargetDir)', '$(SfCoreCargoTarget)', 'debug'))</SfCoreLibDir>
    <SfCoreNativeFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">sf_core.dll</SfCoreNativeFileName>
    <SfCoreNativeFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libsf_core.dylib</SfCoreNativeFileName>
    <SfCoreNativeFileName Condition="'$(SfCoreNativeFileName)' == ''">libsf_core.so</SfCoreNativeFileName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Snowflake.Data/Snowflake.Data.csproj"/>
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventSource" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <PackageReference Include="ZLogger" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(SkipSfCoreBuild)' != 'true'">
    <None Include="$(SfCoreLibDir)$(SfCoreNativeFileName)" Link="$(SfCoreNativeFileName)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildSfCoreNative" BeforeTargets="BeforeBuild" Condition="'$(SkipSfCoreBuild)' != 'true'">
    <Error Condition="$(SfCoreCargoFlags.Contains('--release')) Or $(SfCoreCargoFlags.Contains('--target'))" Text="SfCoreCargoFlags cannot contain --release or --target; set SfCoreCargoTarget for a target triple." />
    <Exec Command="cargo build --locked --package sf_core --target-dir &quot;$(SfCoreTargetDir)&quot; $(SfCoreCargoFlags) $(SfCoreCargoTargetArg)" WorkingDirectory="$(SfCoreRepoRoot)" />
  </Target>
</Project>
