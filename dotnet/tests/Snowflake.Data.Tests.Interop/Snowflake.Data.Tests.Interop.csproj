<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net9.0;net481;net472</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net11.0;net10.0;net9.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Snowflake.Data\Snowflake.Data.csproj" />
    <ProjectReference Include="..\Snowflake.Data.Tests.Common\Snowflake.Data.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildRustStub" BeforeTargets="BeforeBuild" Condition="'$(SkipCargoBuild)' != 'true'">
    <Exec Command="cargo build" WorkingDirectory="$(MSBuildThisFileDirectory)sf_core_stub" ConsoleToMSBuild="true" />
  </Target>

  <Target Name="CopyStubNativeLib" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)sf_core_stub\target\debug\sf_core_stub.dll" DestinationFiles="$(OutDir)sf_core.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)sf_core_stub\target\debug\sf_core_stub.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
