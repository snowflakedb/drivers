<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Snowflake.Data.Proto</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <InternalsVisibleTo Include="Snowflake.Data.UD" />
    <InternalsVisibleTo Include="Snowflake.Data.Tests" />
  </ItemGroup>
  <!-- The C# sources in this project are generated from the protobuf schema and are NOT committed
       to git (see the .NET section of the root .gitignore). Regenerate them with:
         dotnet msbuild -t:RegenerateProto src/Snowflake.Data.Proto/
       CI runs this step before building; run it yourself after a fresh clone or a .proto change. -->
  <PropertyGroup>
    <ProtoFilePath>$(MSBuildThisFileDirectory)../../../protobuf/database_driver_v1.proto</ProtoFilePath>
  </PropertyGroup>
  <Target Name="EnsureProtoGenerated" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)DatabaseDriverV1.cs')" Text="Generated proto code is missing. Run: dotnet msbuild -t:RegenerateProto src/Snowflake.Data.Proto/" />
  </Target>
  <Target Name="RegenerateProto">
    <ItemGroup>
      <GeneratedCsFiles Include="$(MSBuildThisFileDirectory)**/*.cs" Exclude="$(MSBuildThisFileDirectory)Compatibility/**/*.cs" />
    </ItemGroup>
    <Delete Files="@(GeneratedCsFiles)" />
    <RemoveDir Directories="$(MSBuildThisFileDirectory)Exceptions;$(MSBuildThisFileDirectory)DatabaseDriver" />
    <Exec Command="cargo run --bin proto_generator --manifest-path $(MSBuildThisFileDirectory)../../../Cargo.toml -- --generator csharp --input $(ProtoFilePath) --output $(MSBuildThisFileDirectory)" />
    <Message Importance="high" Text="Proto regenerated from $(ProtoFilePath)." />
  </Target>
</Project>
