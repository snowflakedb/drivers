{
  "mappings": [
    {
      "name": "PUT query returns stage info",
      "request": {
        "urlPathPattern": "/queries/v1/query-request.*",
        "method": "POST",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.sqlText",
            "contains": "PUT"
          }
        ]
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "success": true,
          "data": {
            "command": "UPLOAD",
            "stageInfo": {
              "locationType": "S3",
              "location": "mock-stage/",
              "path": "mock-stage/",
              "region": "us-west-2",
              "isClientSideEncrypted": true,
              "creds": {
                "AWS_KEY_ID": "mock_key",
                "AWS_SECRET_KEY": "mock_secret",
                "AWS_TOKEN": "mock_token"
              }
            },
            "encryptionMaterial": {
              "queryStageMasterKey": "mock_key==",
              "queryId": "mock-query-id",
              "smkId": 1
            },
            "src_locations": [
              "{{REPO_ROOT}}/tests/test_data/generated_test_data/compression/test_data.csv"
            ],
            "autoCompress": false,
            "overwrite": false,
            "sourceCompression": "none"
          }
        }
      }
    },
    {
      "name": "First storage PUT returns expired token",
      "scenarioName": "put-token-renewal",
      "requiredScenarioState": "Started",
      "newScenarioState": "token-expired",
      "request": {
        "urlPathPattern": "/mock-stage/.*",
        "method": "PUT"
      },
      "response": {
        "status": 401,
        "body": "Token expired"
      }
    },
    {
      "name": "Token renewal succeeds",
      "scenarioName": "put-token-renewal",
      "requiredScenarioState": "token-expired",
      "newScenarioState": "token-renewed",
      "request": {
        "urlPathPattern": "/session/token-request.*",
        "method": "POST"
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "success": true,
          "data": {
            "sessionToken": "renewed_token"
          }
        }
      }
    },
    {
      "name": "Second storage PUT succeeds",
      "scenarioName": "put-token-renewal",
      "requiredScenarioState": "token-renewed",
      "request": {
        "urlPathPattern": "/mock-stage/.*",
        "method": "PUT"
      },
      "response": {
        "status": 200,
        "body": "OK"
      }
    }
  ]
}
