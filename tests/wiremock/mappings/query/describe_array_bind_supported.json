{
  "name": "Describe-only request reports array bind support",
  "request": {
    "urlPathPattern": "/queries/v1/query-request.*",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.describeOnly"
      },
      {
        "matchesJsonPath": {
          "expression": "$.sqlText",
          "contains": "INSERT INTO t"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "data": {
        "arrayBindSupported": true
      }
    }
  },
  "priority": 2
}
