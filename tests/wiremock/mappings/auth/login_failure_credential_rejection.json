{
  "name": "Login failure with credential-rejection GS code (390100)",
  "request": {
    "urlPathPattern": "/session/v1/login-request.*",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.data[?(@.LOGIN_NAME == 'wiremock_login_failure_390100')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "data": {},
      "success": false,
      "code": "390100",
      "message": "Incorrect username or password was specified."
    }
  }
}
