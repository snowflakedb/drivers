ARG BUILDPLATFORM=linux/amd64

FROM --platform=${BUILDPLATFORM} artifactory.ci1.us-west-2.aws-dev.app.snowflake.com/development-docker-virtual/rust:slim AS chef

# Install build dependencies for Rust and ODBC
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    golang-go \
    unixodbc-dev \
    clang \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workdir

# Copy rust-toolchain.toml to install the correct Rust version
COPY rust-toolchain.toml ./rust-toolchain.toml
RUN rustup show

# Install cargo-chef
RUN cargo install cargo-chef --version 0.1.77 --locked

# cargo-chef rewrites workspace manifests into a dependency-only recipe, so its
# cache-warming cook cannot use the committed workspace lockfile. Keep that
# temporary resolution compatible with the pinned toolchain; the artifact builds
# below still use --locked against the committed Cargo.lock.
ENV CARGO_RESOLVER_INCOMPATIBLE_RUST_VERSIONS=fallback

# TODO SNOW-2705435: Use Clang for aws-lc-fips-sys to avoid GCC >= 14 incompatibility
# See: https://github.com/aws/aws-lc-rs/issues/569
ENV AWS_LC_FIPS_SYS_CC=clang

FROM chef AS planner
# Copy all workspace files - cargo-chef needs the full structure
COPY build_common.rs ./build_common.rs
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY sf_core/ ./sf_core/
COPY sf_params_spec/ ./sf_params_spec/
COPY sf_params_codegen/ ./sf_params_codegen/
COPY sf_mini_core/ ./sf_mini_core/
COPY sf_mini_core_static/ ./sf_mini_core_static/
COPY odbc/ ./odbc/
COPY proto_utils/ ./proto_utils/
COPY proto_generator/ ./proto_generator/
COPY jdbc_bridge/ ./jdbc_bridge/
COPY nodejs_bridge/ ./nodejs_bridge/
COPY protobuf/ ./protobuf/
COPY error_trace/ ./error_trace/
COPY error_trace_derive/ ./error_trace_derive/
COPY proto_generator/ ./proto_generator/
COPY odbc_trace_tool/ ./odbc_trace_tool/
COPY python_bridge/ ./python_bridge/
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Build sf_core and ODBC
FROM chef AS builder
COPY --from=planner /workdir/recipe.json recipe.json

# Copy build-time dependencies needed by build.rs
COPY build_common.rs ./build_common.rs
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY protobuf/ ./protobuf/
COPY error_trace/ ./error_trace/
COPY error_trace_derive/ ./error_trace_derive/
COPY proto_generator/ ./proto_generator/
COPY odbc_trace_tool/ ./odbc_trace_tool/

# Build dependencies - this is the caching layer
# The final locked builds below reuse any matching artifacts from this layer.
RUN cargo chef cook --release --recipe-path recipe.json --package sf_core --package odbc --package jdbc_bridge

# Restore the committed lockfile and every workspace manifest that cargo-chef
# overwrites with its dependency-only recipe. Besides stripping sections such as
# [lib], the recipe stubs package versions as 0.0.1, which is incompatible with
# the reviewed lockfile used by the final --locked builds below.
COPY Cargo.toml Cargo.lock ./
COPY sf_core/Cargo.toml ./sf_core/Cargo.toml
COPY sf_core/tests/common/arrow_deserialize_macro/Cargo.toml ./sf_core/tests/common/arrow_deserialize_macro/Cargo.toml
COPY sf_params_spec/Cargo.toml ./sf_params_spec/Cargo.toml
COPY sf_params_codegen/Cargo.toml ./sf_params_codegen/Cargo.toml
COPY sf_mini_core/Cargo.toml ./sf_mini_core/Cargo.toml
COPY sf_mini_core_static/Cargo.toml ./sf_mini_core_static/Cargo.toml
COPY proto_utils/Cargo.toml ./proto_utils/Cargo.toml
COPY proto_generator/Cargo.toml ./proto_generator/Cargo.toml
COPY error_trace/Cargo.toml ./error_trace/Cargo.toml
COPY error_trace_derive/Cargo.toml ./error_trace_derive/Cargo.toml
COPY odbc/Cargo.toml ./odbc/Cargo.toml
COPY jdbc_bridge/Cargo.toml ./jdbc_bridge/Cargo.toml
COPY nodejs_bridge/Cargo.toml ./nodejs_bridge/Cargo.toml
COPY odbc_trace_tool/Cargo.toml ./odbc_trace_tool/Cargo.toml
COPY python_bridge/Cargo.toml ./python_bridge/Cargo.toml
COPY python_bridge/stub_gen/Cargo.toml ./python_bridge/stub_gen/Cargo.toml

# Copy source files
COPY sf_core/src/ ./sf_core/src/
COPY sf_core/build.rs ./sf_core/build.rs
COPY sf_params_spec/src/ ./sf_params_spec/src/
COPY sf_mini_core/src/ ./sf_mini_core/src/
COPY sf_mini_core_static/src/ ./sf_mini_core_static/src/
COPY proto_utils/src/ ./proto_utils/src/
COPY odbc/src/ ./odbc/src/
COPY odbc/build.rs ./odbc/build.rs
COPY proto_generator/src/ ./proto_generator/src/
COPY jdbc_bridge/src/ ./jdbc_bridge/src/
COPY error_trace/src/ ./error_trace/src/
COPY error_trace_derive/src/ ./error_trace_derive/src/
COPY odbc_trace_tool/src/ ./odbc_trace_tool/src/

# Build sf_core (with perf_timing instrumentation for performance tests).
RUN cargo build --locked --release --package sf_core --features perf_timing && \
    cp target/release/libsf_core.so /workdir/libsf_core.so

# Build ODBC wrapper (with perf_timing instrumentation for performance tests)
RUN cargo build --locked --release --package odbc --features perf_timing && \
    cp target/release/libsfodbc.so /workdir/libsfodbc.so

# Build jdbc_bridge (JNI native lib loaded by the JDBC front-end via CORE_PATH).
# jdbc_bridge has no perf_timing feature, so the JDBC driver app emits base
# per-iteration metrics only (no core-instrumentation columns).
RUN cargo build --locked --release --package jdbc_bridge && \
    cp target/release/libjdbc_bridge.so /workdir/libjdbc_bridge.so
