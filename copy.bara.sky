# Copybara config: two workflows.
#
# 1. `mirror`  — outbound: snowflake-eng/universal-driver -> snowflake-eng/universal-driver-mirror-test
#                (ITERATIVE, direct push, allowlisted paths + internal-marker guards)
#                Runs daily via .github/workflows/mirror.yml.
#
# 2. `import`  — inbound: mirror PRs with the `ok-to-import` label become PRs
#                on the internal repo so they can run against internal CI
#                before merge. Runs on demand via
#                .github/workflows/mirror-inbound.yml.
#
# Initial rollout: destinations/origins point at the TEST mirror
# (universal-driver-mirror-test). Flip to snowflakedb/universal-driver
# once both directions are validated.

SOURCE_REPO = "https://github.com/snowflake-eng/universal-driver"
MIRROR_REPO = "https://github.com/snowflake-eng/universal-driver-mirror-test"

# ALLOWLIST shared by both workflows. Keep this as the single source of
# truth — new dirs/types must be listed here or they stay internal
# (outbound) / are dropped from imported PRs (inbound).
#
# ⚠️  MARKDOWN FILES: .md files are NOT globbed. Each mirrored .md must
#     be listed by exact path. Prevents accidental exposure of internal
#     ADRs or security assessments on the outbound path.
MIRRORED_PATHS = [
    # ── Rust core & workspace crates ──
    "sf_core/**/*.rs", "sf_core/**/Cargo.toml", "sf_core/**/*.def",
    "sf_mini_core/**/*.rs", "sf_mini_core/**/Cargo.toml",
    "sf_mini_core_static/**/*.rs", "sf_mini_core_static/**/Cargo.toml",
    "error_trace/**/*.rs", "error_trace/**/Cargo.toml",
    "error_trace_derive/**/*.rs", "error_trace_derive/**/Cargo.toml",
    "proto_generator/**/*.rs", "proto_generator/**/Cargo.toml",
    "proto_utils/**/*.rs", "proto_utils/**/Cargo.toml",
    "protobuf/**/*.proto",

    # ── Python wrapper (source, config, build, native bridge) ──
    "python/**/*.py", "python/**/*.pyx", "python/**/*.pyi",
    "python/**/*.toml", "python/**/*.lock",
    "python/**/*.c", "python/**/*.cpp", "python/**/*.h", "python/**/*.hpp",
    "python/**/*.txt", "python/**/*.yaml",
    "python/**/*.sh", "python/**/*.sdist", "python/**/*.typed",
    "python/**/.gitignore", "python/**/.clang-format",

    # ── JDBC wrapper ──
    "jdbc/**/*.java", "jdbc/**/*.gradle", "jdbc/**/*.properties", "jdbc/**/*.xml",
    "jdbc/**/*.bat", "jdbc/**/*.jar",
    "jdbc/**/gradlew", "jdbc/**/*.MockMaker", "jdbc/**/*.Driver",
    "jdbc/**/*.rs", "jdbc/**/*.py", "jdbc/**/*.toml",
    "jdbc_bridge/**/*.rs", "jdbc_bridge/**/Cargo.toml",

    # ── ODBC wrapper & tests ──
    "odbc/**/*.rs", "odbc/**/*.cpp", "odbc/**/*.hpp", "odbc/**/*.h",
    "odbc/**/*.toml", "odbc/**/*.def",
    "odbc/**/*.yaml", "odbc/**/*.txt", "odbc/**/*.sh", "odbc/**/*.ps1",
    "odbc/**/*.py",
    "odbc_tests/**/*.cpp", "odbc_tests/**/*.hpp",
    "odbc_tests/**/*.yaml", "odbc_tests/**/*.txt",
    "odbc_tests/**/*.rs", "odbc_tests/**/*.toml",
    "odbc_trace_tool/**/*.rs", "odbc_trace_tool/**/Cargo.toml",

    # ── CI & GitHub config ──
    # NOTE: .github/ is intentionally NOT mirrored outbound. Pushing with
    # a PAT that lacks the `workflow` scope fails when .github/workflows/*
    # files change. Revisit once the mirror bot uses a GitHub App or a
    # token that carries the workflow scope. See implementation.md.
    ".buildkite/**/*.yml",
    ".cargo/**/*.toml",
    "ci/**/Jenkinsfile", "ci/**/Jenkinsfile.*",
    "ci/**/*.sh", "ci/**/*.py", "ci/**/*.yml",
    "ci/**/Dockerfile", "ci/**/Dockerfile.*",
    "ci/**/reference-odbc-*",

    # ── Tests (data, fixtures, perf) ──
    "tests/**/*.rs", "tests/**/*.py", "tests/**/*.java",
    "tests/**/*.feature", "tests/**/*.json", "tests/**/*.csv",
    "tests/**/*.sh", "tests/**/*.yaml",
    "tests/**/*.toml", "tests/**/*.lock",
    "tests/**/*.cpp", "tests/**/*.h", "tests/**/*.hpp",
    "tests/**/*.txt", "tests/**/*.css",
    "tests/**/*.crl", "tests/**/*.p8",
    "tests/**/*.gz", "tests/**/*.br", "tests/**/*.bz2",
    "tests/**/*.zst", "tests/**/*.xz",
    "tests/**/*.deflate", "tests/**/*.raw_deflate",
    "tests/**/*.gpg",
    "tests/**/*.dockerignore", "tests/**/.gitignore",
    "tests/**/Dockerfile", "tests/**/Dockerfile.*",
    "tests/**/Jenkinsfile", "tests/**/Jenkinsfile.*",
    "tests/**/*.jar",

    # ── Scripts ──
    "scripts/**/*.sh", "scripts/**/*.py", "scripts/**/*.bat",
    "scripts/**/*.ps1", "scripts/**/*.sql",

    # ── Root files (explicit, no globs) ──
    "Cargo.toml", "Cargo.lock", "build_common.rs", "rust-toolchain.toml",
    "codecov.yml", "LICENSE", "shell.nix",
    ".clang-format", ".dockerignore", ".envrc",
    ".gitattributes", ".gitignore", ".pre-commit-config.yaml",

    # ── Allowed markdown files (explicit paths, NO globs) ──
    "README.md",
    "sf_core/README.md",
    "sf_core/src/bin/README.md",
    "sf_mini_core/README.md",
    "python/README.md",
    "python/tests/README.md",
    "jdbc/README.md",
    "jdbc/tools/api-coverage/README.md",
    "odbc/README.md",
    "proto_generator/README.md",
    "tests/definitions/README.md",
    "tests/performance/README.md",
    "tests/test_coverage_report/README.md",
    "tests/test_data/generated_test_data/README.md",
    "tests/tests_format_validator/README.md",
    "tests/wiremock/README.md",
    # NOTE: adr/, doc/, .ai/, .cursor/ markdown files are intentionally
    # NOT listed — they may contain internal ADRs or security assessments.
    # To mirror a new .md file, add its exact path here.
]


# ┌─────────────────────────────────────────────────────────────────────┐
# │ OUTBOUND: internal main -> public mirror main                       │
# └─────────────────────────────────────────────────────────────────────┘
core.workflow(
    name = "mirror",
    # ITERATIVE preserves linear source history — one destination commit
    # per origin commit, original author and message. Copybara still writes
    # a `GitOrigin-RevId: <sha>` trailer on each commit for tracking.
    mode = "ITERATIVE",
    origin = git.github_origin(
        url = SOURCE_REPO,
        ref = "main",
    ),
    # Direct push — no PR gate. Safety relies on the allowlist + the
    # verify_match checks below, plus environment approval on dispatch.
    destination = git.github_destination(
        url = MIRROR_REPO,
        push = "main",
    ),
    authoring = authoring.pass_thru(
        "Mirror Bot <mirror-bot@snowflake.com>"
    ),
    origin_files = glob(MIRRORED_PATHS),
    transformations = [
        # Fail the sync if any mirrored file references the internal repo.
        # The mirror workflow itself is excluded because it legitimately
        # names the source repository.
        core.verify_match(
            regex = "snowflake-eng/universal-driver",
            paths = glob(["**"], exclude = [".github/workflows/mirror*"]),
            verify_no_match = True,
        ),
        # Fail the sync if any mirrored file references internal hostnames.
        core.verify_match(
            regex = "\\.snowflakecomputing\\.internal|\\.corp\\.snowflake",
            verify_no_match = True,
        ),
    ],
)


# ┌─────────────────────────────────────────────────────────────────────┐
# │ INBOUND: labeled mirror PR -> PR on internal repo                   │
# ├─────────────────────────────────────────────────────────────────────┤
# │ Gate: required_labels = ["ok-to-import"]. External code never       │
# │ enters the internal repo without a maintainer explicitly labeling   │
# │ the mirror PR. Invocation:                                          │
# │                                                                     │
# │   copybara migrate copy.bara.sky import <PR_NUMBER>                 │
# │                                                                     │
# │ Contributor authorship is preserved on the imported commits         │
# │ (authoring.pass_thru_default). The resulting internal PR runs       │
# │ against full internal CI before merge; when merged to main the      │
# │ outbound `mirror` workflow pushes the change back to the mirror on  │
# │ its next run, closing the loop.                                     │
# └─────────────────────────────────────────────────────────────────────┘
core.workflow(
    name = "import",
    mode = "CHANGE_REQUEST",
    origin = git.github_pr_origin(
        url = MIRROR_REPO,
        required_labels = ["ok-to-import"],
        # Pull only open PRs — merged or closed PRs don't need importing.
        state = "OPEN",
        branch = "main",
    ),
    # Create a PR on the internal repo so internal CI and reviewers see it.
    destination = git.github_pr_destination(
        url = SOURCE_REPO,
        destination_ref = "main",
        pr_branch = "import-mirror-pr-${GITHUB_PR_NUMBER}",
        title = "Import mirror PR #${GITHUB_PR_NUMBER}: ${GITHUB_PR_TITLE}",
        body = "Imported from ${GITHUB_PR_URL} (author: @${GITHUB_PR_USER_LOGIN}).\n\n"
               + "${GITHUB_PR_BODY}\n\n"
               + "---\n"
               + "Internal CI validates this change before merge. "
               + "On merge to main the outbound mirror will push the commit "
               + "back to the public repo; close the original mirror PR "
               + "with a link to the mirrored commit.",
        integrates = [],
    ),
    # pass_thru preserves the external contributor's authorship on
    # imported commits. The string argument is the fallback identity used
    # only when the origin commit has no author metadata.
    authoring = authoring.pass_thru(
        "Mirror Bot <mirror-bot@snowflake.com>"
    ),
    # Same allowlist as outbound — anything outside it is silently dropped
    # from the imported PR. Intentional: external contributors cannot add
    # files to .github/, adr/, .ai/, etc. even if they try.
    origin_files = glob(MIRRORED_PATHS),
    transformations = [
        # Defensive: internal hostnames should never appear in a mirror PR,
        # but fail loudly if they somehow do.
        core.verify_match(
            regex = "\\.snowflakecomputing\\.internal|\\.corp\\.snowflake",
            verify_no_match = True,
        ),
    ],
)
