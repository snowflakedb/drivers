# Copybara config: two workflows.
#
# 1. `mirror`  — outbound: snowflake-eng/universal-driver -> snowflakedb/ud-mirror-test
#                (ITERATIVE, direct push, denylist filter + internal-marker guards)
#                Runs daily via .github/workflows/mirror.yml.
#
# 2. `import`  — inbound: mirror PRs with the `ok-to-import` label become PRs
#                on the internal repo so they can run against internal CI
#                before merge. Runs on demand via
#                .github/workflows/mirror-inbound.yml.
#
# Initial rollout: destinations/origins point at the TEST mirror
# (ud-mirror-test). Flip to snowflakedb/universal-driver
# once both directions are validated.

SOURCE_REPO = "https://github.com/snowflake-eng/universal-driver"
MIRROR_REPO = "https://github.com/snowflakedb/ud-mirror-test"

# DENYLIST: mirror everything except paths matching these patterns.
#
# Safety model
# ------------
# A denylist defaults to "public" for new files, which is the opposite of
# what a mirror config typically wants. We compensate with two things:
#
#   1. `_internal/` convention: put any new internal-only material under
#      `_internal/` and it's covered without touching this file.
#   2. Manifest snapshot: `.mirror/manifest.txt` pins the exact set of
#      files Copybara would push. A CI check (validations.yml::mirror-
#      manifest) fails every PR whose actual mirrored file-set drifts
#      from the checked-in manifest. Adding a brand-new internal file
#      therefore forces a visible `.mirror/manifest.txt` diff that a
#      reviewer has to approve.
#
# Keep this list small. Broad catch-alls live in the pattern section at
# the bottom. Narrow, explicit per-path entries live in the top section.
EXCLUDED_PATHS = [
    # ── Internal-only top-level directories (existing) ──
    "adr/**",
    "doc/**",
    ".ai/**",
    ".cursor/**",
    ".claude/**",
    ".idea/**",
    ".direnv/**",

    # Conventional home for NEW internal material. Prefer adding files
    # here rather than inventing a new top-level exclusion.
    "_internal/**",

    # ── Mirror machinery itself ──
    "copy.bara.sky",
    "implementation.md",
    ".mirror/**",
    ".github/workflows/mirror*.yml",
    "Universal Driver Source Mirroring*.md",

    # ── .github/ excluded in full ──
    # The mirror token is a classic PAT without the `workflow` scope, so
    # pushing .github/workflows/* files is rejected by GitHub. Tracked as
    # a follow-up in implementation.md. When the token gains the scope,
    # narrow this to `.github/workflows/mirror*.yml` only.
    ".github/**",

    # ── Name-based catch-alls ──
    # Match any file whose name looks internal regardless of where it
    # lives in the tree.
    "**/*.internal.*",
    "**/*_internal*",
    "**/SECURITY_ASSESSMENT*",
    "**/SECURITY_AUDIT*",
    "**/*SECURITY_NOTES*",
]


# ┌─────────────────────────────────────────────────────────────────────┐
# │ OUTBOUND: internal main -> public mirror main                       │
# └─────────────────────────────────────────────────────────────────────┘
core.workflow(
    name = "mirror",
    # ITERATIVE preserves linear source history — one destination commit
    # per origin commit, original author and message. Copybara still writes
    # a `GitOrigin-RevId: <sha>` trailer on each commit for tracking.
    mode = "ITERATIVE",
    origin = git.github_origin(
        url = SOURCE_REPO,
        ref = "main",
    ),
    # Direct push — no PR gate. Safety relies on the denylist + the
    # verify_match checks below, plus environment approval on dispatch,
    # plus the validations.yml mirror-manifest PR check.
    destination = git.github_destination(
        url = MIRROR_REPO,
        push = "main",
    ),
    authoring = authoring.pass_thru(
        "Mirror Bot <mirror-bot@snowflake.com>"
    ),
    origin_files = glob(["**"], exclude = EXCLUDED_PATHS),
    transformations = [
        # Fail the sync if any mirrored file references the internal repo.
        # The mirror workflow itself is excluded because it legitimately
        # names the source repository.
        core.verify_match(
            regex = "snowflake-eng/universal-driver",
            paths = glob(["**"], exclude = [".github/workflows/mirror*"]),
            verify_no_match = True,
        ),
        # Fail the sync if any mirrored file references internal hostnames.
        core.verify_match(
            regex = "\\.snowflakecomputing\\.internal|\\.corp\\.snowflake",
            verify_no_match = True,
        ),
    ],
)


# ┌─────────────────────────────────────────────────────────────────────┐
# │ INBOUND: labeled mirror PR -> PR on internal repo                   │
# ├─────────────────────────────────────────────────────────────────────┤
# │ Gate: required_labels = ["ok-to-import"]. External code never       │
# │ enters the internal repo without a maintainer explicitly labeling   │
# │ the mirror PR. Invocation:                                          │
# │                                                                     │
# │   copybara migrate copy.bara.sky import <PR_NUMBER>                 │
# │                                                                     │
# │ Contributor authorship is preserved on the imported commits         │
# │ (authoring.pass_thru). The resulting internal PR runs against full  │
# │ internal CI before merge; when merged to main the outbound `mirror` │
# │ workflow pushes the change back to the mirror on its next run,      │
# │ closing the loop.                                                   │
# └─────────────────────────────────────────────────────────────────────┘
core.workflow(
    name = "import",
    mode = "CHANGE_REQUEST",
    origin = git.github_pr_origin(
        url = MIRROR_REPO,
        required_labels = ["ok-to-import"],
        # Pull only open PRs — merged or closed PRs don't need importing.
        state = "OPEN",
        branch = "main",
    ),
    # Create a PR on the internal repo so internal CI and reviewers see it.
    #
    # NOTE: pr_branch is intentionally omitted — Copybara's `pr_branch`
    # field does NOT interpolate ${LABEL} placeholders. Without it,
    # github_pr_destination derives a unique per-PR branch automatically.
    #
    # Only labels that git.github_pr_origin actually exposes may appear
    # in title/body: GITHUB_PR_NUMBER, GITHUB_PR_TITLE, GITHUB_PR_BODY,
    # GITHUB_PR_URL, GITHUB_PR_HEAD_SHA. Author login is NOT available
    # as a label — Copybara carries it on the imported commit's author
    # metadata instead (via authoring.pass_thru below).
    destination = git.github_pr_destination(
        url = SOURCE_REPO,
        destination_ref = "main",
        title = "Import mirror PR #${GITHUB_PR_NUMBER}: ${GITHUB_PR_TITLE}",
        body = "Imported from ${GITHUB_PR_URL}.\n\n"
               + "Original PR body:\n\n"
               + "${GITHUB_PR_BODY}\n\n"
               + "---\n"
               + "Internal CI validates this change before merge. "
               + "On merge to main the outbound mirror will push the commit "
               + "back to the public repo; close the original mirror PR "
               + "with a link to the mirrored commit.",
        integrates = [],
    ),
    # pass_thru preserves the external contributor's authorship on
    # imported commits. The string argument is the fallback identity used
    # only when the origin commit has no author metadata.
    authoring = authoring.pass_thru(
        "Mirror Bot <mirror-bot@snowflake.com>"
    ),
    # Same denylist as outbound — anything matching EXCLUDED_PATHS is
    # silently dropped from the imported PR. Intentional: external
    # contributors cannot add files to .github/, adr/, _internal/, etc.
    # even if they try.
    origin_files = glob(["**"], exclude = EXCLUDED_PATHS),
    transformations = [
        # Defensive: internal hostnames should never appear in a mirror PR,
        # but fail loudly if they somehow do.
        core.verify_match(
            regex = "\\.snowflakecomputing\\.internal|\\.corp\\.snowflake",
            verify_no_match = True,
        ),
    ],
)
