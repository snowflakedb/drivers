{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
